# 2. LOAD DATASET
# ==========================================

df = pd.read_csv("C:/Users/Mayank Raj/Downloads/Telco-Customer-Churn.csv")


# ==========================================
# 3. BASIC DATASET UNDERSTANDING
# ==========================================

print("First 5 Rows:")
